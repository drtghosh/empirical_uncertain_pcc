ninja_required_version = 1.3
cxx = c++
nvcc = /usr/bin/nvcc

cflags = -pthread -B /clusterstorage/dghosh/miniforge3/envs/deb/compiler_compat -DNDEBUG -fwrapv -O2 -Wall -fPIC -O2 -isystem /clusterstorage/dghosh/miniforge3/envs/deb/include -fPIC -O2 -isystem /clusterstorage/dghosh/miniforge3/envs/deb/include -fPIC -I/clusterstorage/dghosh/miniforge3/envs/deb/lib/python3.11/site-packages/torch/include -I/clusterstorage/dghosh/miniforge3/envs/deb/lib/python3.11/site-packages/torch/include/torch/csrc/api/include -I/clusterstorage/dghosh/miniforge3/envs/deb/lib/python3.11/site-packages/torch/include/TH -I/clusterstorage/dghosh/miniforge3/envs/deb/lib/python3.11/site-packages/torch/include/THC -I/clusterstorage/dghosh/miniforge3/envs/deb/include/python3.11 -c
post_cflags = -DTORCH_API_INCLUDE_EXTENSION_H '-DPYBIND11_COMPILER_TYPE="_gcc"' '-DPYBIND11_STDLIB="_libstdcpp"' '-DPYBIND11_BUILD_ABI="_cxxabi1011"' -DTORCH_EXTENSION_NAME=emd -D_GLIBCXX_USE_CXX11_ABI=0 -std=c++17
cuda_cflags = -I/clusterstorage/dghosh/miniforge3/envs/deb/lib/python3.11/site-packages/torch/include -I/clusterstorage/dghosh/miniforge3/envs/deb/lib/python3.11/site-packages/torch/include/torch/csrc/api/include -I/clusterstorage/dghosh/miniforge3/envs/deb/lib/python3.11/site-packages/torch/include/TH -I/clusterstorage/dghosh/miniforge3/envs/deb/lib/python3.11/site-packages/torch/include/THC -I/clusterstorage/dghosh/miniforge3/envs/deb/include/python3.11 -c
cuda_post_cflags = -D__CUDA_NO_HALF_OPERATORS__ -D__CUDA_NO_HALF_CONVERSIONS__ -D__CUDA_NO_BFLOAT16_CONVERSIONS__ -D__CUDA_NO_HALF2_OPERATORS__ --expt-relaxed-constexpr --compiler-options ''"'"'-fPIC'"'"'' -DTORCH_API_INCLUDE_EXTENSION_H '-DPYBIND11_COMPILER_TYPE="_gcc"' '-DPYBIND11_STDLIB="_libstdcpp"' '-DPYBIND11_BUILD_ABI="_cxxabi1011"' -DTORCH_EXTENSION_NAME=emd -D_GLIBCXX_USE_CXX11_ABI=0 -gencode=arch=compute_61,code=compute_61 -gencode=arch=compute_61,code=sm_61 -std=c++17
cuda_dlink_post_cflags = 
ldflags = 

rule compile
  command = $cxx -MMD -MF $out.d $cflags -c $in -o $out $post_cflags
  depfile = $out.d
  deps = gcc

rule cuda_compile
  depfile = $out.d
  deps = gcc
  command = $nvcc --generate-dependencies-with-compile --dependency-output $out.d $cuda_cflags -c $in -o $out $cuda_post_cflags





build /servers/ash/hdd-home3/dghosh/Documents/Thesis/empirical_uncertain_pcc/metrics/EMD/build/temp.linux-x86_64-cpython-311/emd.o: compile /servers/ash/hdd-home3/dghosh/Documents/Thesis/empirical_uncertain_pcc/metrics/EMD/emd.cpp
build /servers/ash/hdd-home3/dghosh/Documents/Thesis/empirical_uncertain_pcc/metrics/EMD/build/temp.linux-x86_64-cpython-311/emd_cuda.o: cuda_compile /servers/ash/hdd-home3/dghosh/Documents/Thesis/empirical_uncertain_pcc/metrics/EMD/emd_cuda.cu






